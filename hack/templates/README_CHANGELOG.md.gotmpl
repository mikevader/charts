{{- define "custom.changelog.header" -}}
## Changelog
{{- end -}}

{{- define "custom.changelog" -}}
{{- $chart := .Files.Get "Chart.yaml" | fromYaml -}}
{{- $raw := "" -}}
{{- with $chart.annotations -}}
  {{- $raw = index . "artifacthub.io/changes" | default "" -}}
{{- end -}}
{{- $changes := list -}}
{{- if $raw -}}
  {{- $changes = (printf "changes:\n%s" ($raw | indent 2) | fromYaml).changes | default list -}}
{{- end -}}
{{ template "custom.changelog.header" . }}

### Version {{ template "chart.version" . }}
{{- range $kind := list "added" "changed" "deprecated" "removed" "fixed" "security" }}
  {{- $entries := list -}}
  {{- range $changes }}
    {{- if eq (.kind | toString) $kind }}{{ $entries = append $entries .description }}{{ end -}}
  {{- end }}
  {{- if $entries }}

#### {{ $kind | title }}
{{ range $entries }}
- {{ . }}
{{- end }}
  {{- end }}
{{- end }}
{{- if not $changes }}

N/A
{{- end }}

### Older versions

A historical overview of changes can be found on the [GitHub releases](https://github.com/mikevader/charts/releases?q={{ template "chart.name" . }}&expanded=true) page.
{{- end -}}
